{
	"name": "phpgt/gtcommand",
	"description": "Provides the `gt` command for automating WebEngine development.",
	"bin": [
		"bin/gt"
	],


	"config": {
		"platform": {
			"php": "8.4.0"
		}
	},

	"require": {
		"php": ">=8.4",
		"phpgt/cli": "^2.0.1",
		"phpgt/server": "^1.4",
		"phpgt/cron": "^1.3",
		"phpgt/config": "^1.3",
		"phpgt/database": "^1.8.2",
		"phpgt/build": "^1.6"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^12.5",
		"phpmd/phpmd": "^3.0",
		"squizlabs/php_codesniffer": "^4.0"
	},
	"suggest": {
		"phpgt/orm": "Enables automatic Entity schema migrations from gt migrate"
	},

	"autoload": {
		"psr-4": {
			"GT\\GtCommand\\": "./src",
			"Gt\\GtCommand\\": "./src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GT\\GtCommand\\Test\\": "./test/phpunit"
		}
	},

	"scripts": {
		"phpunit": "vendor/bin/phpunit --configuration phpunit.xml",
		"phpcs": "vendor/bin/phpcs src --standard=phpcs.xml",
		"phpmd": "vendor/bin/phpmd src/ text phpmd.xml",
		"phpstan": "vendor/bin/phpstan analyse --level 6 src --memory-limit 256M",
		"test": [
			"@phpunit",
			"@phpcs",
			"@phpmd",
			"@phpstan"
		]
	},

	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/phpgt"
		}
	]
}
